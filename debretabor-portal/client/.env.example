# Dev: leave unset - vite.config.js proxies "/api/*" to http://localhost:5000.
# Production: full URL of the API (with /api).
# VITE_API_BASE_URL=https://api.debretabor.gov.et/api

# Backend origin (scheme + host + port, no path) used to build links to uploaded files (/uploads/...).
VITE_API_ORIGIN=http://localhost:5000

# Where the "Admin Login" footer link points (the separate /admin app).
VITE_ADMIN_URL=http://localhost:5174/admin/login

# Footer contact details (anything left empty is hidden).
VITE_CONTACT_ADDRESS=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
